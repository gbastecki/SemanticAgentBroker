<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- NuGet Package Metadata -->
    <PackageId>SemanticAgentBroker.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>Grzegorz Bastecki</Authors>
    <Description>Plugin SDK for SemanticAgentBroker. Reference this package to create custom agent plugins that are loaded dynamically at runtime.</Description>
    <PackageTags>semantic-kernel;agent;plugin;sdk;extensible</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

</Project>
