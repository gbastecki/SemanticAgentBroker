{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SemanticAgentBroker.Core.LoadBalancing": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AiProviders": {
    "DefaultTimeoutMinutes": 60,
    "MaxTokensPerRequest": 8192,
    "MaxAssistantOutputLength": 24000,
    "MaxToolObservationLength": 24000,
    "AutoSaveToolOutputThreshold": 3000,
    "ToolOutputPreviewLength": 500,
    "Inference": {
      "MaxLlmRetries": -1,
      "LlmRetryDelaySeconds": 5,
      "MaxLlmRetryDelaySeconds": 30,
      "MaxFormatRetries": 3,
      "MaxFinalAnswerInlineChars": 4000,
      "StopMarkers": [
        "<|im_end|>",
        "<|endoftext|>",
        "<end_of_turn>",
        "<eos>"
      ],
      "ThoughtPrefixesToStrip": [
        "<channel|>Thought",
        "<channel|>",
        "</channel>",
        "<|thought|>",
        "<thought>",
        "</thought>",
        "[THOUGHT]"
      ],
      "MainExecutionPromptSettings": {
        "temperature": 0.0,
        "presence_penalty": 0.1,
        "num_predict": 8192,
        "max_tokens": 8192,
        "num_ctx": 32768
      },
      "NudgedExecutionPromptSettings": {
        "temperature": 0.2,
        "presence_penalty": 0.2,
        "num_predict": 8192,
        "max_tokens": 8192,
        "num_ctx": 32768
      },
      "PlanningPromptSettings": {
        "temperature": 0.2,
        "presence_penalty": 0.1,
        "num_predict": 8192,
        "max_tokens": 8192,
        "num_ctx": 32768
      },
      "SummarizationPromptSettings": {
        "temperature": 0.0,
        "num_predict": 1200
      },
      "ArtifactReplacements": {
        "<|im_end|>": "\n",
        "<|endoftext|>": "\n",
        "<end_of_turn>": "\n",
        "**FinalAnswer:**": "FinalAnswer:",
        "**Plan:**": "Plan:",
        "Final Answer:": "FinalAnswer:"
      }
    },
    "HealthCheck": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "TimeoutSeconds": 5,
      "EndpointPaths": {
        "OpenAiCompatible": "/v1/models",
        "Ollama": "/v1/models",
        "OpenAi": "/v1/models"
      }
    },
    "ModelRouting": {
      "PrimaryTextModel": {
        "ModelId": "Qwen/Qwen3.8-27B"
      },
      "SummarizationModel": {
        "ModelId": "google/gemma-4-26B-A4B-it"
      }
    },
    "Connections": [
      {
        "Id": "vLLMPrimary",
        "EndpointName": "vLLM Production Cluster (localhost:8000)",
        "ProviderType": "OpenAiCompatible",
        "Endpoint": "http://localhost:8000/v1",
        "IsEnabled": true,
        "HttpBasicAuthUsername": "",
        "HttpBasicAuthPassword": "",
        "ApiKey": "vllm-token-or-dummy",
        "TrustUntrustedCertificates": true,
        "Models": [
          {
            "Id": "Qwen/Qwen3.8-27B",
            "Type": "Text",
            "MaxContextTokens": 32768,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": "%CURRENT_USER%\\SemanticAgentBrokerData\\Tokenizers\\qwen_tokenizer.json",
              "FallbackDivisor": 2.3,
              "PerMessageOverhead": 20
            },
            "ThoughtPrefixesToStrip": [
              "<|thought|>",
              "<thought>",
              "</thought>"
            ]
          },
          {
            "Id": "Qwen/Qwen3.8-27B",
            "Type": "Vision",
            "MaxContextTokens": 32768,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": "%CURRENT_USER%\\SemanticAgentBrokerData\\Tokenizers\\qwen_tokenizer.json",
              "FallbackDivisor": 2.3,
              "PerMessageOverhead": 20
            }
          },
          {
            "Id": "google/gemma-4-26B-A4B-it",
            "Type": "Text",
            "MaxContextTokens": 32768,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": "%CURRENT_USER%\\SemanticAgentBrokerData\\Tokenizers\\gemma4_tokenizer.json",
              "FallbackDivisor": 2.5,
              "PerMessageOverhead": 20
            },
            "ThoughtPrefixesToStrip": [
              "<channel|>Thought",
              "<channel|>",
              "</channel>"
            ]
          },
          {
            "Id": "google/gemma-4-26B-A4B-it",
            "Type": "Vision",
            "MaxContextTokens": 32768,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": "%CURRENT_USER%\\SemanticAgentBrokerData\\Tokenizers\\gemma4_tokenizer.json",
              "FallbackDivisor": 2.5,
              "PerMessageOverhead": 20
            }
          }
        ]
      }
    ],
    "PythonSandbox": {
      "ImageName": "ai-sandbox-python:latest",
      "TimeoutSeconds": 60,
      "MemoryLimitMb": 512,
      "MaxOutputMb": 50,
      "DockerUri": "",
      "ContainerDataPath": "/app/workdir",
      "HostDataPath": "TaskWorkspaces"
    },
    "ContextCompaction": {
      "CompactionThreshold": 0.8,
      "KeepRecentMessages": 6,
      "MaxSummaryTokens": 1200,
      "EnableStructuredStateTracking": true,
      "NudgeReductionAfterStep": 5,
      "MaxStepLogChars": 1500,
      "MaxStateInjectionTokens": 16000,
      "RecentStepFullObservationChars": 4000
    }
  },
  "AgentSystem": {
    "MaxConcurrentAgents": 3,
    "DatabaseConnectionString": "Data Source=%CURRENT_USER%\\SemanticAgentBrokerData\\broker.db",
    "AuthDatabaseConnectionString": "Data Source=%CURRENT_USER%\\SemanticAgentBrokerData\\auth.db",
    "TokensDatabaseConnectionString": "Data Source=%CURRENT_USER%\\SemanticAgentBrokerData\\tokens.db",
    "DefaultAdminUsername": "admin",
    "DefaultAdminPassword": "admin",
    "SessionDays": 7,
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5,
    "TraceLogsDirectory": "%CURRENT_USER%\\SemanticAgentBrokerData\\TraceLogs",
    "MaxFileReadChars": 8000,
    "PluginsDirectory": "Plugins",
    "TaskWorkspacesPath": "%CURRENT_USER%\\SemanticAgentBrokerData\\TaskWorkspaces",
    "CleanupWorkspacesOnTaskDelete": true,
    "MaxUploadSizeMb": 10,
    "MaxDownloadSizeMb": 50,
    "MaxFileEditSizeMb": 50,
    "MaxAutoLoadFileSizeMb": 50,
    "RestApi": {
      "IsEnabled": true,
      "Host": "0.0.0.0",
      "HttpPort": null,
      "HttpsPort": 5100,
      "Port": 5100
    },
    "Certificate": null,
    "IsTasksCleanupServiceEnabled": true,
    "TasksCleanupDays": 14,
    "Cors": {
      "AllowAll": true,
      "AllowedOrigins": []
    },
    "Plugins": {
      "WorkspaceInfo": {
        "MaxDepth": 100
      }
    },
    "HttpClientSecurity": {
      "EnableBlocklist": true,
      "EnableAllowlist": false,
      "BlockedPatterns": [
        "127.*", "10.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*",
        "172.20.*", "172.21.*", "172.22.*", "172.23.*", "172.24.*",
        "172.25.*", "172.26.*", "172.27.*", "172.28.*", "172.29.*",
        "172.30.*", "172.31.*", "192.168.*", "0.*", "169.254.*",
        "::1", "fc00::*", "fe80::*", "localhost"
      ],
      "AllowedPatterns": []
    }
  }
}
