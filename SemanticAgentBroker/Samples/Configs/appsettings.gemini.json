{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SemanticAgentBroker.Core.LoadBalancing": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AiProviders": {
    "DefaultTimeoutMinutes": 60,
    "MaxTokensPerRequest": 8192,
    "MaxAssistantOutputLength": 24000,
    "MaxToolObservationLength": 24000,
    "AutoSaveToolOutputThreshold": 3000,
    "ToolOutputPreviewLength": 500,
    "Inference": {
      "MaxLlmRetries": 5,
      "LlmRetryDelaySeconds": 2,
      "MaxLlmRetryDelaySeconds": 15,
      "MaxFormatRetries": 3,
      "MaxFinalAnswerInlineChars": 4000,
      "StopMarkers": [],
      "ThoughtPrefixesToStrip": [
        "<thought>",
        "</thought>",
        "[THOUGHT]"
      ],
      "MainExecutionPromptSettings": {
        "temperature": 0.0,
        "max_tokens": 8192
      },
      "NudgedExecutionPromptSettings": {
        "temperature": 0.2,
        "presence_penalty": 0.2,
        "max_tokens": 8192
      },
      "PlanningPromptSettings": {
        "temperature": 0.2,
        "max_tokens": 8192
      },
      "SummarizationPromptSettings": {
        "temperature": 0.0,
        "max_tokens": 1200
      },
      "ArtifactReplacements": {
        "**FinalAnswer:**": "FinalAnswer:",
        "**Plan:**": "Plan:",
        "Final Answer:": "FinalAnswer:"
      }
    },
    "HealthCheck": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "TimeoutSeconds": 5,
      "EndpointPaths": {
        "OpenAiCompatible": "/v1/models",
        "OpenAi": "/v1/models",
        "Ollama": "/v1/models"
      }
    },
    "ModelRouting": {
      "PrimaryTextModel": {
        "ModelId": "gemini-3.6-flash"
      },
      "SummarizationModel": {
        "ModelId": "gemini-3.5-flash-lite"
      }
    },
    "Connections": [
      {
        "Id": "GoogleGeminiOfficial",
        "EndpointName": "Google Gemini OpenAI-Compatible Endpoint (generativelanguage.googleapis.com)",
        "ProviderType": "OpenAiCompatible",
        "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "IsEnabled": true,
        "HttpBasicAuthUsername": "",
        "HttpBasicAuthPassword": "",
        "ApiKey": "AIzaSyYOUR_GOOGLE_AI_STUDIO_API_KEY_HERE",
        "TrustUntrustedCertificates": false,
        "Models": [
          {
            "Id": "gemini-3.6-flash",
            "Type": "Text",
            "MaxContextTokens": 1048576,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": null,
              "FallbackDivisor": 3.0,
              "PerMessageOverhead": 20
            }
          },
          {
            "Id": "gemini-3.6-flash",
            "Type": "Vision",
            "MaxContextTokens": 1048576,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": null,
              "FallbackDivisor": 3.0,
              "PerMessageOverhead": 20
            }
          },
          {
            "Id": "gemini-3.5-flash-lite",
            "Type": "Text",
            "MaxContextTokens": 1048576,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": null,
              "FallbackDivisor": 3.0,
              "PerMessageOverhead": 20
            }
          },
          {
            "Id": "gemini-3.5-flash-lite",
            "Type": "Vision",
            "MaxContextTokens": 1048576,
            "TokenCounting": {
              "TokenizerModel": "gpt-4o",
              "TokenizerJsonPath": null,
              "FallbackDivisor": 3.0,
              "PerMessageOverhead": 20
            }
          }
        ]
      }
    ],
    "PythonSandbox": {
      "ImageName": "ai-sandbox-python:latest",
      "TimeoutSeconds": 60,
      "MemoryLimitMb": 512,
      "MaxOutputMb": 50,
      "DockerUri": "",
      "ContainerDataPath": "/app/workdir",
      "HostDataPath": "TaskWorkspaces"
    },
    "ContextCompaction": {
      "CompactionThreshold": 0.9,
      "KeepRecentMessages": 10,
      "MaxSummaryTokens": 1200,
      "EnableStructuredStateTracking": true,
      "NudgeReductionAfterStep": 5,
      "MaxStepLogChars": 1500,
      "MaxStateInjectionTokens": 16000,
      "RecentStepFullObservationChars": 4000
    }
  },
  "AgentSystem": {
    "MaxConcurrentAgents": 3,
    "DatabaseConnectionString": "Data Source=%CURRENT_USER%\\SemanticAgentBrokerData\\broker.db",
    "AuthDatabaseConnectionString": "Data Source=%CURRENT_USER%\\SemanticAgentBrokerData\\auth.db",
    "TokensDatabaseConnectionString": "Data Source=%CURRENT_USER%\\SemanticAgentBrokerData\\tokens.db",
    "DefaultAdminUsername": "admin",
    "DefaultAdminPassword": "admin",
    "SessionDays": 7,
    "MaxFailedAttempts": 10,
    "LockoutMinutes": 5,
    "TraceLogsDirectory": "%CURRENT_USER%\\SemanticAgentBrokerData\\TraceLogs",
    "MaxFileReadChars": 8000,
    "PluginsDirectory": "Plugins",
    "TaskWorkspacesPath": "%CURRENT_USER%\\SemanticAgentBrokerData\\TaskWorkspaces",
    "CleanupWorkspacesOnTaskDelete": true,
    "MaxUploadSizeMb": 10,
    "MaxDownloadSizeMb": 50,
    "MaxFileEditSizeMb": 50,
    "MaxAutoLoadFileSizeMb": 50,
    "RestApi": {
      "IsEnabled": true,
      "Host": "0.0.0.0",
      "HttpPort": null,
      "HttpsPort": 5100,
      "Port": 5100
    },
    "Certificate": null,
    "IsTasksCleanupServiceEnabled": true,
    "TasksCleanupDays": 14,
    "Cors": {
      "AllowAll": true,
      "AllowedOrigins": []
    },
    "Plugins": {
      "WorkspaceInfo": {
        "MaxDepth": 100
      }
    },
    "HttpClientSecurity": {
      "EnableBlocklist": true,
      "EnableAllowlist": false,
      "BlockedPatterns": [
        "127.*", "10.*", "172.16.*", "172.17.*", "172.18.*", "172.19.*",
        "172.20.*", "172.21.*", "172.22.*", "172.23.*", "172.24.*",
        "172.25.*", "172.26.*", "172.27.*", "172.28.*", "172.29.*",
        "172.30.*", "172.31.*", "192.168.*", "0.*", "169.254.*",
        "::1", "fc00::*", "fe80::*", "localhost"
      ],
      "AllowedPatterns": []
    }
  }
}
