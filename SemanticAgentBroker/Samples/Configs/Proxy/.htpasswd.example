# ==============================================================================
# Example .htpasswd file for Nginx HTTP Basic Authentication
# ==============================================================================
# Default user: agent_user
# Default password: SecretAgentPassword123!
# Hash format: APR1 (Apache MD5) or Bcrypt
#
# To generate a new .htpasswd file on Linux / macOS:
#   htpasswd -bc .htpasswd myusername mypassword
#
# To append additional users:
#   htpasswd -b .htpasswd anotheruser anotherpassword
#
# To generate via Docker without installing apache2-utils locally:
#   docker run --rm httpd:alpine htpasswd -nbB agent_user SecretAgentPassword123! > .htpasswd
#
# To generate via Python:
#   python -c 'import crypt; print("user:" + crypt.crypt("pass", crypt.mksalt(crypt.METHOD_SHA512)))'
# ==============================================================================
agent_user:$apr1$b5qN6V5.$O.oG8cghw4Lh8Z1P4/h2k/
