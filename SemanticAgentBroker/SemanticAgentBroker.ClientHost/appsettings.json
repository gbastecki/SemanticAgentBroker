{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ClientHost": {
    "Host": "0.0.0.0",
    "HttpPort": null,
    "HttpsPort": 7050,
    "RedirectHttpToHttps": false,

    "ClientSettings": {
      "ApiBaseUrl": "https://localhost:5100/",
      "EnvironmentName": "Production",
      "CustomSettings": {}
    },

    "Certificate": {
      "Path": null,
      "Password": null,
      "StoreLocation": null,
      "StoreName": null,
      "Thumbprint": null
    },

    "Cors": {
      "AllowAll": true,
      "AllowedOrigins": [],
      "AllowedMethods": [],
      "AllowedHeaders": [],
      "AllowCredentials": true
    },

    "ForwardedHeaders": {
      "Enabled": true,
      "TrustAllProxies": false,
      "KnownProxies": [],
      "KnownNetworks": []
    },

    "SecurityHeaders": {
      "EnableHsts": false,
      "HstsMaxAgeDays": 365,
      "HstsIncludeSubdomains": true,
      "HstsPreload": false,
      "XContentTypeOptions": "nosniff",
      "XFrameOptions": "SAMEORIGIN",
      "ReferrerPolicy": "strict-origin-when-cross-origin",
      "ContentSecurityPolicy": null,
      "PermissionsPolicy": null
    },

    "Compression": {
      "EnableCompression": true,
      "EnableForHttps": true
    },

    "StaticFiles": {
      "FrameworkCacheMaxAgeSeconds": 31536000,
      "HtmlCacheMaxAgeSeconds": 0
    },

    "HealthCheck": {
      "Enabled": true,
      "Path": "/health"
    }
  }
}
