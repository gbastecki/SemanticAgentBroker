<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticAgentBroker.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.81.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference SDK and Shared but do NOT copy to output - the host already has them. -->
    <ProjectReference Include="..\SemanticAgentBroker.Sdk\SemanticAgentBroker.Sdk.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
    <ProjectReference Include="..\SemanticAgentBroker.Shared\SemanticAgentBroker.Shared.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <!-- Copy built DLL + deps.json to the Api's Plugins/BuiltIn.Optional/ subdirectory. -->
  <Target Name="CopyToPluginsDir" AfterTargets="Build">
    <PropertyGroup>
      <EffectiveSolutionDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</EffectiveSolutionDir>
      <EffectiveSolutionDir Condition="'$(EffectiveSolutionDir)' == ''">$(SolutionDir)</EffectiveSolutionDir>
      <PluginsOutputDir>$(EffectiveSolutionDir)SemanticAgentBroker.Api\bin\$(Configuration)\$(TargetFramework)\Plugins\BuiltIn.Optional\</PluginsOutputDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsOutputDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsOutputDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(TargetName).deps.json" DestinationFolder="$(PluginsOutputDir)" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(TargetName).deps.json')" />
    <Copy SourceFiles="@(ReferenceCopyLocalPaths)" DestinationFolder="$(PluginsOutputDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
